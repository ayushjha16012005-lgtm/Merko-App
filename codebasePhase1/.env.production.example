# Production Environment Variables

# Node environment
NODE_ENV=production

# Core API and Networking
PORT=4000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Database (PostgreSQL)
# Used for runtime connection pooling
DATABASE_URL="postgresql://postgres:secure_password_here@postgres:5432/merko?schema=public&connection_limit=5"
# Used for migrations
DIRECT_URL="postgresql://postgres:secure_password_here@postgres:5432/merko?schema=public"

# Database Init Variables (Used by docker-compose postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=merko

# Redis
REDIS_URL="redis://redis:6379"

# Security & Authentication
# Replace with a high-entropy string (e.g. `openssl rand -base64 32`)
JWT_SECRET=super_secure_production_jwt_secret_change_me
JWT_EXPIRATION="7d"

# Payment Gateway (Razorpay)
# Ensure these are production keys, not test keys.
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional Services (Storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=
